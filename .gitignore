# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# package-lock.json is committed — CI runs `npm ci` (deterministic install) and
# actions/setup-node `cache: npm` both require it. Keep it in sync after a version
# bump with `npm install` (see CLAUDE.md release flow).
yarn.lock
pnpm-lock.yaml

# Build / dist
# Root-anchored: the repo-root dist/ is a build artifact and stays ignored,
# but plugins/claude-code/dist/ is COMMITTED on purpose — the marketplace
# plugin is git-distributed, so it must carry its bundled engine (v0.5.2).
/dist/
build/
out/
*.tsbuildinfo

# Stray local artifacts (not part of the repo)
presentation.zip

# Coverage
coverage/
.nyc_output/

# Logs
*.log
logs/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.fleet/

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Cache
.cache/
.parcel-cache/
.eslintcache
.next/
.turbo/

# Test artifacts
test-results/
playwright-report/
*.snap.png

# Cladding runtime state — audit log, events log, etc. (config.yaml stays committable)
.cladding/*
!.cladding/config.yaml

# A/B-extended generated React demo projects.
# These are regeneratable on demand via `UPDATE_AB_REPORTS=1 npx vitest run`
# but should not bloat the repository — keep them local-only.
docs/ab-evaluation-extended/scenarios/*/cladding/
docs/ab-evaluation-extended/scenarios/*/vanilla/

# Local screen recordings — source for README GIFs, regeneratable; keep out of the repo.
*.mov
